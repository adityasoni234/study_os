# --- Database ---
# Postgres (docker-compose): postgresql+psycopg://studyos:studyos@localhost:5432/studyos
# Dev fallback (zero infra):  sqlite:///./studyos.db
DATABASE_URL=sqlite:///./studyos.db

# --- AI providers (never commit real keys) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed if your Anthropic key is org-level (not scoped to a workspace).
ANTHROPIC_WORKSPACE_ID=

# mock | live | auto  (auto = live when keys are present, mock otherwise)
AI_MODE=auto
# GPT->Claude review for deep evaluation tasks (costlier; off by default)
CROSS_CHECK=false

# --- Embeddings ---
# auto | mock | openai
EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Opportunity search ---
# mock | web (adapter interface; mock ships curated data)
SEARCH_PROVIDER=mock

# --- App ---
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=120
